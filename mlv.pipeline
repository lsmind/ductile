#!/usr/bin/env -S ductile run
// mlv.pipeline — v0.24 自组织治理超图 v3.1（外援终审「可施工」版实施；g 轮复验「验收通过」+加固池清零）。
//
// 双轨：旧 12 步（kernel-binding 冻结字节断言）+ 新 22 步（mlv 治理内核协议串，含 f6 三步：
// fp-build 源内容摘要增量→fp-matrix 五点位 failpoint→fp-race feature-off+可观察 race 栅栏）。
// 新步负例走独立夹具账本：harness 显式 ductile mlv <path> init 后直路径 append（f3 冻结规格：生产 CLI 无 fixture 语法）。
// kill 步=父进程注入 SIGKILL 后重启验证（RECOVERED count=N）；race 栅栏=父持 flock 观察双子进程 wchan 阻塞后释放。
// 链式 .needs() 排序（run() 裸文本无字段，.when 门禁必假——skill 坑#9）。

Pipeline("mlv", "v0.24 治理超图 v3.1：双轨 34 步（旧断言冻结+治理协议串+f6 failpoint/race 门禁）", cwd="${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)}")

  // ── 旧轨：kernel-binding 冻结断言（字节不变）────────────────────
  .proc("clean", run("rm -rf target/mlv target/mlv-unpacked target/mlv-bundle.tar.zst target/mlv-fx && mkdir -p target/mlv"))
    .desc("清场（重跑幂等）")

  .proc("init-old", run("ductile kernel-binding target/mlv/ledger.jsonl propose scan-gate 1 actor-llm"))
    .desc("旧轨入口：propose（冻结协议串）")
    .needs(@clean)

  .proc("grant-old", run("ductile kernel-binding target/mlv/ledger.jsonl advance scan-gate 1 GRANTED genesis-root"))
    .desc("授权（冻结）")
    .needs(@init-old)

  .proc("decide-old", run("ductile kernel-binding target/mlv/ledger.jsonl advance scan-gate 1 DECIDED judge-a"))
    .desc("独立裁决（冻结）")
    .needs(@grant-old)

  .proc("activate-old", run("ductile kernel-binding target/mlv/ledger.jsonl advance scan-gate 1 ACTIVATING actor-ops && ductile kernel-binding target/mlv/ledger.jsonl advance scan-gate 1 ACTIVE actor-ops && ductile kernel-binding target/mlv/ledger.jsonl status scan-gate"))
    .desc("两段激活+回读（冻结）")
    .needs(@decide-old)

  .proc("ledger", run("ductile kernel-ledger target/mlv/ledger.jsonl --verify"))
    .desc("证据账本链验证（LEDGER-OK）")
    .needs(@activate-old)

  .proc("tamper-old", run("cp target/mlv/ledger.jsonl /tmp/mlv_backup.jsonl && sed -i 's/scan-gate/EVIL-ID/' target/mlv/ledger.jsonl && { ductile kernel-ledger target/mlv/ledger.jsonl --verify >/dev/null 2>&1 && echo BAD-tamper-undetected || echo tamper-detected-ok; }; cp /tmp/mlv_backup.jsonl target/mlv/ledger.jsonl"))
    .desc("防伪负例（冻结判定串）")
    .needs(@ledger)

  .proc("illegal-old", run("ductile kernel-binding target/mlv/ledger.jsonl advance scan-gate 1 PROPOSED actor-x > /tmp/mlv_illegal.out 2>&1; if grep -q ADVANCE-FAIL /tmp/mlv_illegal.out; then echo illegal-edge-rejected-ok; else echo BAD-illegal-edge-passed; exit 1; fi"))
    .desc("非法边必拒（冻结）")
    .needs(@tamper-old)

  .proc("revoke-old", run("ductile kernel-binding target/mlv/ledger.jsonl advance scan-gate 1 REVOKED actor-ops && ductile kernel-binding target/mlv/ledger.jsonl advance scan-gate 1 ACTIVE actor-x > /tmp/mlv_revive.out 2>&1; if grep -q ADVANCE-FAIL /tmp/mlv_revive.out; then echo terminal-no-revive-ok; else echo BAD-revive-passed; exit 1; fi; ductile kernel-binding target/mlv/ledger.jsonl status scan-gate"))
    .desc("终态+复活必拒（冻结）")
    .needs(@illegal-old)

  .proc("pack", run("ductile kernel-reproduce target/mlv -o target/mlv-bundle.tar.zst"))
    .desc("reproduce 包")
    .needs(@revoke-old)

  .proc("unpack", run("mkdir -p target/mlv-unpacked && tar --zstd -xf target/mlv-bundle.tar.zst -C target/mlv-unpacked"))
    .desc("第三方视角解包")
    .needs(@pack)

  .proc("verify-old", run("ductile kernel-reproduce --verify target/mlv-unpacked"))
    .desc("离线验证（REPRODUCE-OK）")
    .needs(@unpack)

  // ── 新轨：mlv 治理内核（v3.1 协议串）────────────────────────────
  .proc("init", run("ductile mlv target/mlv/gov.jsonl init"))
    .desc("步2 显式 init（OK init v1）")
    .needs(@clean)

  .proc("create", run("ductile mlv target/mlv/gov.jsonl create b1 0"))
    .desc("步3 CREATE_PROPOSAL（OK create）")
    .needs(@init)

  .proc("ack", run("ductile mlv target/mlv/gov.jsonl create b1 0"))
    .desc("步4 幂等重试（ACK code=OK）")
    .needs(@create)

  .proc("conflict", run("ductile mlv target/mlv/fixture-conflict/ledger.jsonl init > /dev/null 2>&1; ductile mlv target/mlv/fixture-conflict/ledger.jsonl append --op CREATE_PROPOSAL --binding fx --rev 0 --rk same --at 100 > /dev/null 2>&1; python3 -c \"import pathlib;p=pathlib.Path('target/mlv/fixture-conflict/ledger.jsonl');d=p.read_bytes();i=d.find(b'sha256:');p.write_bytes(d[:i+7]+b'deadbeef'+d[i+15:])\"; ductile mlv target/mlv/fixture-conflict/ledger.jsonl verify > /tmp/mlv_conflict.out 2>&1 || true; if grep -q 'ERR' /tmp/mlv_conflict.out; then echo digest-tamper-rejected-ok; else echo BAD-digest-tamper-passed; exit 1; fi"))
    .desc("步5 摘要篡改必拒（改 request_digest 前缀→record_hash 失配→verify 拒）")
    .needs(@ack)

  .proc("grant", run("ductile mlv target/mlv/gov.jsonl grant b1 0"))
    .desc("步6 GRANT")
    .needs(@conflict)

  .proc("decide", run("ductile mlv target/mlv/gov.jsonl decide b1 0"))
    .desc("步7 DECISION")
    .needs(@grant)

  .proc("begin", run("ductile mlv target/mlv/gov.jsonl begin b1 0"))
    .desc("步8 ACTIVATE_BEGIN")
    .needs(@decide)

  .proc("confirm", run("ductile mlv target/mlv/gov.jsonl registry-confirm b1 0"))
    .desc("步9 REGISTRY_CONFIRM（回执登记）")
    .needs(@begin)

  .proc("commit", run("ductile mlv target/mlv/gov.jsonl commit b1 0"))
    .desc("步10 ACTIVATE_COMMIT（回执门禁后 ACTIVE）")
    .needs(@confirm)

  .proc("ledger-new", run("ductile mlv target/mlv/gov.jsonl verify"))
    .desc("步11 账本验证（OK ledger head=）")
    .needs(@commit)

  .proc("replay", run("ductile mlv target/mlv/gov.jsonl status b1 > /tmp/mlv_replay.out 2>&1 && grep -q 'state=ACTIVE' /tmp/mlv_replay.out && echo replay-equal-ok || { echo BAD-replay; exit 1; }"))
    .desc("步12 全量重放等价（open=重放→状态一致）")
    .needs(@ledger-new)

  .proc("tamper-new", run("cp target/mlv/gov.jsonl /tmp/gov_bak.jsonl && sed -i 's/\"op\":\"GRANT\"/\"op\":\"EVIL\"/' target/mlv/gov.jsonl; ductile mlv target/mlv/gov.jsonl verify > /tmp/mlv_tamper.out 2>&1; if grep -q 'ERR' /tmp/mlv_tamper.out; then echo tamper-detected-ok; else echo BAD-tamper; exit 1; fi; cp /tmp/gov_bak.jsonl target/mlv/gov.jsonl"))
    .desc("步13 篡改任一字节必拒（独立于旧轨同型步）")
    .needs(@replay)

  .proc("illegal-new", run("ductile mlv target/mlv/gov.jsonl append --op GRANT --binding b1 --rev 0 --rk fresh-illegal-probe --at 100 > /tmp/mlv_illegal2.out 2>&1 || true; if grep -q 'E422 illegal-edge' /tmp/mlv_illegal2.out; then echo illegal-edge-rejected-ok; else echo BAD-illegal; exit 1; fi"))
    .desc("步14 非法边（ACTIVE 上再 GRANT）必拒")
    .needs(@tamper-new)

  .proc("abandon-cycle", run("ductile mlv target/mlv/gov.jsonl create b2 0 > /dev/null && ductile mlv target/mlv/gov.jsonl grant b2 0 > /dev/null && ductile mlv target/mlv/gov.jsonl decide b2 0 > /dev/null && ductile mlv target/mlv/gov.jsonl begin b2 0 > /dev/null && ductile mlv target/mlv/gov.jsonl abandon b2 0 && ductile mlv target/mlv/gov.jsonl begin b2 0"))
    .desc("步15 ABANDON 唯一放弃出口+重新 begin（P3）")
    .needs(@illegal-new)

  .proc("receipt-gate", run("ductile mlv target/mlv/fixture-norcpt/ledger.jsonl init > /dev/null 2>&1; ductile mlv target/mlv/fixture-norcpt/ledger.jsonl append --op CREATE_PROPOSAL --binding b3 --rev 0 --rk r --at 100 > /dev/null 2>&1; ductile mlv target/mlv/fixture-norcpt/ledger.jsonl append --op GRANT --binding b3 --rev 0 --rk r --at 100 > /dev/null 2>&1; ductile mlv target/mlv/fixture-norcpt/ledger.jsonl append --op DECISION --binding b3 --rev 0 --rk r --at 100 > /dev/null 2>&1; ductile mlv target/mlv/fixture-norcpt/ledger.jsonl append --op ACTIVATE_BEGIN --binding b3 --rev 0 --rk r --at 100 > /dev/null 2>&1; ductile mlv target/mlv/fixture-norcpt/ledger.jsonl append --op ACTIVATE_COMMIT --binding b3 --rev 0 --rk r --at 100 > /tmp/mlv_rcpt.out 2>&1; if grep -q 'receipt-required' /tmp/mlv_rcpt.out; then echo receipt-gate-ok; else echo BAD-receipt; exit 1; fi"))
    .desc("步16 无回执 COMMIT 必拒（receipt-required）")
    .needs(@abandon-cycle)

  .proc("terminal-new", run("ductile mlv target/mlv/gov.jsonl revoke b1 0 > /dev/null && ductile mlv target/mlv/gov.jsonl terminal b1 0 > /tmp/mlv_term.out 2>&1; if grep -q 'ERR terminal' /tmp/mlv_term.out; then echo terminal-no-revive-ok; else echo BAD-terminal; exit 1; fi"))
    .desc("步17 终态不可复活（REVOKED 上 TERMINAL 拒）")
    .needs(@receipt-gate)

  .proc("missing", run("ductile mlv /tmp/mlv-no-such-ledger.jsonl verify > /tmp/mlv_missing.out 2>&1; if grep -q 'ledger-missing' /tmp/mlv_missing.out; then echo missing-refused-ok; else echo BAD-missing; exit 1; fi"))
    .desc("步18 缺账本必拒（不自动建）")
    .needs(@terminal-new)

  .proc("concurrent", run("bash scripts/mlv_concurrent_once.sh > /tmp/mlv_conc.out 2>&1; if grep -q 'ONE-WINS' /tmp/mlv_conc.out; then echo concurrent-one-wins-ok; else echo BAD-concurrent; cat /tmp/mlv_conc.out; exit 1; fi"))
    .desc("步19 双进程并发仅一胜（ONE-WINS）")
    .needs(@missing)

  .proc("kill9", run("bash scripts/mlv_kill9_once.sh > /tmp/mlv_kill.out 2>&1; if grep -q 'RECOVERED' /tmp/mlv_kill.out; then echo kill9-recovered-ok; else echo BAD-kill; cat /tmp/mlv_kill.out; exit 1; fi"))
    .desc("步20 kill -9 半提交恢复（RECOVERED）")
    .needs(@concurrent)

  .proc("fp-build", run("cd /home/beef/projects/ductile && HASH=$(cat src/kernel/gov.rs src/kernel/mlv.rs Cargo.toml | sha256sum | cut -c1-16); STAMP=target/failpoint/.src-hash; if [ ! -x target/failpoint/release/ductile ] || [ $(cat $STAMP 2>/dev/null) != $HASH ]; then cargo build --release --features mlv-failpoint --target-dir target/failpoint > /tmp/mlv_fpbuild.out 2>&1 && echo $HASH > $STAMP; fi; if [ -x target/failpoint/release/ductile ]; then echo fp-build-ok; else echo BAD-fp-build; tail -20 /tmp/mlv_fpbuild.out; exit 1; fi"))
    .desc("步21 f6 failpoint 构建门（源内容摘要判增量——mtime 保留时间戳恢复会复用旧二进制；生产 target/ 不动）")
    .needs(@kill9)

  .proc("fp-matrix", run("bash scripts/mlv_failpoint_matrix.sh > /tmp/mlv_fpm.out 2>&1; if grep -q 'F6-CRASH-MATRIX-PASS' /tmp/mlv_fpm.out; then echo failpoint-matrix-ok; else echo BAD-fp-matrix; cat /tmp/mlv_fpm.out; exit 1; fi"))
    .desc("步22 f6 五点位 failpoint 矩阵（abort→老本/新本+verify）")
    .needs(@fp-build)

  .proc("fp-race", run("bash scripts/mlv_feature_off_race.sh > /tmp/mlv_fpr.out 2>&1; if grep -q 'F6-OFF-AND-RACE-PASS' /tmp/mlv_fpr.out; then echo feature-off-and-race-ok; else echo BAD-fp-race; cat /tmp/mlv_fpr.out; exit 1; fi"))
    .desc("步23 f6 feature-off 生产面+可观察 race 栅栏（父持锁→观察阻塞→释放）")
    .needs(@fp-matrix)

  .proc("deliver", run("echo MLV-V31-SUITE-PASS"))
    .deliver(@verify-old, @fp-race)
