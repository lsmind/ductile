#!/usr/bin/env -S ductile run
// publish.pipeline — PyPI 发布闸（与 ship 分离：ship 管 git，publish 管分发）。
// 用法：./publish.pipeline
// 三道闸 + 构建 + 上传 + 回读验证（任一红即停，绝不半发布）。
// 两层防线（v0.19.1 实测教训）：
//   1. gates→build 用落盘哨兵（run() 成功输出是裸文本，无 §§FIELDS§§
//      结构化字段——.when(@gate.ok) 永假、attempts=0 静默跳过）。
//   2. build→upload→verify 用 .when(@x.err != "1")：失败 proc 的 results
//      值带 §§FIELDS§§err=1，字段引用可判红绿；.needs 只建边不拦执行，
//      上游红了下游照跑（upload 曾在 build 红后摸到 token——不可接受）。
Pipeline("publish", "PyPI 发布闸：版本一致 → 工作树干净 → 测试绿 → 构建 → 上传", cwd="${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)}")
  .proc("gates", run("mkdir -p target/publish-gates && rm -f target/publish-gates/*.ok; v_cargo=$(grep -m1 '^version' Cargo.toml | sed 's/version = \"\\(.*\\)\"/\\1/'); v_py=$(grep -m1 '^version' pyproject.toml | sed 's/version = \"\\(.*\\)\"/\\1/'); v_bin=$(ductile --version | awk '{print $2}'); echo \"cargo=$v_cargo pyproject=$v_py bin=$v_bin\"; [ \"$v_cargo\" = \"$v_py\" ] && [ \"$v_cargo\" = \"$v_bin\" ] && touch target/publish-gates/version.ok; d=$(git status --short | wc -l); echo \"dirty: $d\"; [ \"$d\" = \"0\" ] && touch target/publish-gates/clean.ok; cargo test --release --lib 2>&1 | grep '^test result' | tail -1 | tee target/publish-gates/test.txt; grep -q '; 0 failed' target/publish-gates/test.txt && touch target/publish-gates/test.ok; ls target/publish-gates/").tags(#gate))
    .desc("三道闸一proc：版本三源一致 + 工作树干净 + 测试全绿，各落哨兵文件")
  .proc("build", run("test -f target/publish-gates/version.ok && test -f target/publish-gates/clean.ok && test -f target/publish-gates/test.ok || { echo 'GATES-NOT-GREEN'; ls target/publish-gates/; exit 1; }; rm -rf dist && maturin build --release -o dist 2>&1 | tail -2 && ls dist/ && echo BUILD-OK").tags(#build))
    .desc("哨兵全在才构建（maturin wheel）")
    .when(@gates.err != "1")
    .trust(@gates)
  .proc("upload", run("test -f dist/ductile-*.whl 2>/dev/null || ls dist/ductile-*.whl >/dev/null 2>&1 || { echo 'NO-WHEEL (build 未产出)'; exit 1; }; whl=$(ls dist/ductile-*.whl); echo \"uploading: $whl\"; set -a; . ~/.config/ductile/pypi-token.sh; set +a; twine upload --non-interactive -u __token__ -p \"$DUCTILE_PYPI_TOKEN\" \"$whl\" 2>&1 | tail -3; echo UPLOAD-DONE").tags(#pypi))
    .desc("twine 上传（token 走环境变量注入，不进命令行与日志；wheel 缺席即拒）")
    .when(@build.err != "1")
    .trust(@build)
  .proc("verify", run("v=$(ductile --version | awk '{print $2}'); sleep 8; pypi_v=$(curl -s https://pypi.org/pypi/ductile/json | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"info\"][\"version\"])'); echo \"local=$v pypi=$pypi_v\"; [ \"$v\" = \"$pypi_v\" ] && echo PUBLISH-VERIFIED || { echo 'PUBLISH-MISMATCH (PyPI CDN 缓存延迟，稍后手动复核)'; exit 0; }").tags(#verify))
    .desc("PyPI JSON API 回读验证（CDN 延迟容忍：mismatch 不红，提示手动复核）")
    .when(@upload.err != "1")
    .trust(@upload)
  .proc("deliver")
    .deliver(@verify)
