#!/usr/bin/env -S ductile run
// workflows/devcycle-start.pipeline — 从用户指令到 agent handoff（编码前）
// 用法：ductile run workflows/devcycle-start.pipeline "用户自然语言指令"
// 产出：target/devcycle/plan.env + handoff.md；有 LLM 则结构化抽取，否则 stub
// 下一步：智能体按 handoff 改代码 → ductile run workflows/devcycle-land.pipeline "commit msg"
Pipeline("devcycle_start", "指令→计划→预检→handoff 落盘")
  .proc("intake")
    .desc("固化用户指令")
    .plan(
      w -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && mkdir -p target/devcycle && printf '%s\n' '{topic}' > target/devcycle/instruction.txt && echo ok")
        .tags(#write, #intent)
    )
  .proc("plan")
    .desc("结构化计划（LLM 优先，stub 兜底）")
    .plan(
      live -> llm(
        prompt=@intake,
        system="你是 ductile 仓库工程助手。把用户指令收成短计划。commit_msg 用中文或英文 feat/fix/docs 前缀，一行。needs_hyper/needs_docs 填 true 或 false。",
        schema="summary,kind,commit_msg,needs_hyper,needs_docs,touch_hint,risks"
      )
        .tags(#llm, #plan)
        .desc("结构化抽取"),
      stub -> run("echo intake='@intake' >/dev/null; printf '%s\\n' '##DSL_RESULT' 'summary=stub-plan-from-topic' 'kind=feat' \"commit_msg={topic}\" 'needs_hyper=false' 'needs_docs=true' 'touch_hint=see-git-status' 'risks=no-llm-config' '##DSL_END'")
        .tags(#plan, #stub)
        .desc("无 API 时本地计划")
    )
  .proc("preflight")
    .desc("仓库预检：状态 + 超图复用提示")
    .plan(
      p -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && mkdir -p target/devcycle && echo plan='@plan' >/dev/null && { echo '## git'; git status -sb; echo; echo '## hyper similar (soft)'; ductile hyper similar examples/hyper/unstructured_extract.hyper --json examples/hyper 2>/dev/null | head -c 2000 || echo 'hyper-skip'; } > target/devcycle/preflight.txt && echo preflight-ok")
        .tags(#git, #scan)
    )
  .proc("handoff")
    .desc("写给智能体的执行卡")
    .plan(
      h -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && mkdir -p target/devcycle && OUT=target/devcycle/handoff.md && { echo '# Ductile devcycle handoff'; echo; echo '## Instruction'; cat target/devcycle/instruction.txt; echo; echo '## Plan'; echo '@plan'; echo; echo '## Preflight'; cat target/devcycle/preflight.txt; echo; echo '## Agent checklist'; echo '1. Use .pipeline / .hyper (explicit gate ports)'; echo '2. selftest: ductile run ./selftest.pipeline'; echo '3. land: ductile run workflows/devcycle-land.pipeline \"<commit_msg>\"'; echo '4. Hyper constrains shape only'; echo; echo '## Done when'; echo '- SELFTEST-PASS then ship/land commit'; } > \"$OUT\" && echo pre='@preflight' >/dev/null && echo HANDOFF-READY && wc -l \"$OUT\"")
        .tags(#write, #agent)
    )
  .proc("deliver")
    .deliver(@handoff)
