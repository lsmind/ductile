// workflows/devcycle.hyper — 全生命周期拓扑图（文档/parse；分段 check 用 *-start|land.hyper）
HyperGraph("devcycle")
  .goal("user instruction -> plan -> preflight -> handoff -> verify -> ship -> report")
  .require(judge=true, min_impls=1)
  .vertex("intake", role=source, tags=#intent)
  .vertex("plan", role=default, tags=#llm)
  .vertex("preflight", role=default, tags=#git)
  .vertex("handoff", role=default, tags=#write)
  .vertex("verify", role=default, tags=#test)
  .vertex("gate", role=judge, tags=#gate)
  .vertex("ship", role=default, tags=#git)
  .vertex("report", role=sink, tags=#write)
  .hedge("start", kind=chain, intake, plan, preflight, handoff)
  .hedge("land", kind=chain, verify, ship)
  .hedge("out", kind=chain, verify, report)
  .hedge("bridge", kind=chain, handoff, verify)
  .hedge("quality", kind=gate, judge=gate, producers=verify, consumers=ship)
  .hedge("quality_out", kind=gate, judge=gate, producers=verify, consumers=report)
  .hedge("kit", kind=bundle, verify, gate, ship, report)
  .deliver(report)
