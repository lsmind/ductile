#!/usr/bin/env -S ductile run
// workflows/devcycle-land.pipeline — 验证→裁判→落盘→报告（编码后）
// 用法：ductile run workflows/devcycle-land.pipeline "feat: 提交说明"
// 门禁：selftest SELFTEST-PASS 才 ship；ship 内再跑 cargo test 并 commit（+push）
Pipeline("devcycle_land", "verify → gate → ship → report")
  .proc("preflight")
    .desc("落盘前快检：工作区非空或允许空提交跳过由 ship 处理")
    .plan(
      p -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && mkdir -p target/devcycle && git status -sb > target/devcycle/land-preflight.txt && echo preflight-ok")
        .tags(#git)
    )
  .proc("verify")
    .desc("完整自测门禁（unit+探针+脚本+hyper）")
    .plan(
      v -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && export DUCTILE_HOME=\"${DUCTILE_HOME:-$ROOT/examples}\" DUCTILE_DATA=\"${DUCTILE_DATA:-$ROOT/examples}\" && echo preflight='@preflight' >/dev/null && ductile run ./selftest.pipeline 2>&1 | tee target/devcycle/selftest.log | tail -20")
        .tags(#test, #selftest)
    )
  .proc("gate")
    .desc("裁判：必须 SELFTEST-PASS")
    .plan(
      g -> run("echo '@verify' | grep -q SELFTEST-PASS && printf '%s\\n' '##DSL_RESULT' 'score=100' 'verdict=pass' '##DSL_END' || (printf '%s\\n' '##DSL_RESULT' 'score=0' 'verdict=fail' '##DSL_END'; exit 1)")
        .tags(#gate, #judge)
    )
  .proc("ship")
    .desc("测试门禁 → add → commit → push（ship.pipeline）")
    .when(@gate.score >= 80)
    .plan(
      s -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && echo verify='@verify' >/dev/null && ductile run ./ship.pipeline '{topic}' 2>&1 | tee target/devcycle/ship.log | tail -30")
        .tags(#git, #ship)
        .retry(n=1)
    )
  .proc("report")
    .desc("周期报告落盘")
    .when(@gate.score >= 80)
    .plan(
      r -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && mkdir -p target/devcycle && echo verify='@verify' >/dev/null && { echo '# devcycle land report'; echo; echo \"topic: {topic}\"; echo; echo '## gate'; echo '@gate'; echo; echo '## ship (tail)'; tail -15 target/devcycle/ship.log 2>/dev/null; echo; echo '## git'; git log --oneline -3; git status -sb; } > target/devcycle/report.md && echo DEVCYCLE-LAND-PASS && cat target/devcycle/report.md")
        .tags(#write, #report)
    )
  .proc("deliver")
    .deliver(@report)
