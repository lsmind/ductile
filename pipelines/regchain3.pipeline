#!/usr/bin/env -S ductile run
// regchain3.pipeline — 三臂对比链：ductile-27B / ductile-8B / 裸27B（game 场景）
// 依赖边用 echo '@ref' 落盘 + grep 模式（run() 结果是 Text 无字段，
// .when(@x.ok) 会 fail-closed 判死——skill 记载坑，regcheck3 同款写法）。
// regchain 产物路径固定（reg_*.txt），各臂跑完立刻 cp 分臂存档（g27_/g8_/gbar_）。
Pipeline("regchain3", "三臂对比：管线27B vs 管线8B vs 裸27B", cwd="/tmp/regchain_data")

  // ===== 臂A：ductile 27B（auto-prompt 全开，architect 钉 medium）=====
  .proc("chain", run("DUCTILE_CONFIG=/tmp/regchain_data/regconf.toml ductile run /home/beef/projects/ductile/pipelines/regchain.pipeline \"$(cat /tmp/regchain_data/story_game.txt)\" > game_chain.log 2>&1 && grep -q 'executed successfully' game_chain.log && cp reg_req.txt g27_req.txt && cp reg_arch.txt g27_arch.txt && cp reg_brk.txt g27_brk.txt && cp reg_audit.txt g27_audit.txt && echo chain-ok"))

  // ===== 臂B：ductile 8B（tiers 全钉 light = lfm2.5-8b）=====
  .proc("chain8", run("{ echo '@chain'; } > c8dep.txt && grep -q chain-ok c8dep.txt && sed 's/tiers = \"[a-z,]*\"/tiers = \"light\"/g' /tmp/regchain_data/regconf.toml > /tmp/regchain_data/regconf8.toml && grep -c 'tiers = \"light\"' /tmp/regchain_data/regconf8.toml && DUCTILE_CONFIG=/tmp/regchain_data/regconf8.toml ductile run /home/beef/projects/ductile/pipelines/regchain.pipeline \"$(cat /tmp/regchain_data/story_game.txt)\" > game_chain8.log 2>&1 && grep -q 'executed successfully' game_chain8.log && cp reg_req.txt g8_req.txt && cp reg_arch.txt g8_arch.txt && cp reg_brk.txt g8_brk.txt && cp reg_audit.txt g8_audit.txt && echo chain8-ok"))

  // ===== 臂C：裸 27B（无管线：单发直出五段，同 schema 无上下文承接）=====
  .proc("bare", run("{ echo '@chain8'; } > cbdep.txt && grep -q chain8-ok cbdep.txt && DUCTILE_CONFIG=/tmp/regchain_data/regconf.toml ductile run /home/beef/projects/ductile/pipelines/regbare.pipeline \"$(cat /tmp/regchain_data/story_game.txt)\" > game_bare.log 2>&1 && grep -q 'executed successfully' game_bare.log && echo bare-ok"))

  .proc("deliver")
    .deliver(@bare)
