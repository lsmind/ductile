#!/usr/bin/env -S ductile run
// regcheck.pipeline — auto-prompt 回归门禁 e2e：链 → 材料 → 盲评 → 解盲门禁
// 用法：DUCTILE_DATA=/tmp/regchain_data ductile run pipelines/regcheck.pipeline "regression"
// 依赖机制：run() 结果是 Text 无字段（.when(@x.ok) 对 Text fail-closed 判死），
// 但命令内 '@x' 字面量即依赖边（selftest 落盘门禁同款）——每阶段先落上一阶段
// 输出再 grep，依赖边 + 内容门一体。任一阶段失败 → 下游 propagated，管线判死。
Pipeline("regcheck", "auto-prompt 回归门禁 e2e", cwd="/tmp/regchain_data")
  .proc("chain", run("DUCTILE_CONFIG=/tmp/regchain_data/regconf.toml ductile run /home/beef/projects/ductile/pipelines/regchain.pipeline \"$(cat /tmp/regchain_data/story.txt)\" > reg_chain.log 2>&1 && grep -q 'executed successfully' reg_chain.log && echo chain-ok"))
    .desc("阶段1：五段裸 agent 链（auto-prompt 全开）")
  .proc("materials", run("{ echo '@chain'; } > st1.txt && grep -q chain-ok st1.txt && python3 /home/beef/projects/ductile/scripts/regchain_materials.py > reg_mat.log 2>&1 && echo materials-ok"))
    .desc("阶段2：提取产物→匿名化→轮换→材料文件（reg_s0..s3.txt）")
  .proc("judge", run("{ echo '@materials'; } > st2.txt && grep -q materials-ok st2.txt && DUCTILE_CONFIG=/tmp/regchain_data/regconf.toml ductile run /home/beef/projects/ductile/pipelines/regjudge.pipeline 盲评 > reg_judge.log 2>&1 && grep -q 'executed successfully' reg_judge.log && echo judge-ok"))
    .desc("阶段3：四段盲评（35B 独立裁判）")
  .proc("tally", run("{ echo '@judge'; } > st3.txt && grep -q judge-ok st3.txt && python3 /home/beef/projects/ductile/scripts/regchain_tally.py > reg_tally.log 2>&1 && grep -q REGCHAIN-PASS reg_tally.log && echo tally-ok"))
    .desc("阶段4：解盲汇总+门禁（auto < baseline-5 → 非0退出）")
  .proc("report", run("{ echo '@tally'; } > st4.txt && grep -q tally-ok st4.txt && cat reg_tally.log && echo REGCHECK-PASS"))
    .desc("终报：打印解盲分数 + REGCHECK-PASS")
  .proc("deliver", run("echo done"))
    .deliver(@report)
