#!/usr/bin/env -S ductile run
// selftest.pipeline — ductile 自测（狗粮门禁）：单测+正负探针+脚本回归+hyper 复用
// 直跑：./selftest.pipeline   全绿输出 SELFTEST-PASS（exit 0）；任一失败 → report 判死 → exit 1
// 注意：llm-ping 依赖外部 LLM 桥，不进自测（避免网络抖动误杀门禁）
// 仓库根：优先 $DUCTILE_ROOT，否则 git rev-parse
// PATH：引擎 run/spawn 自动注入 current_exe 与 target/{release,debug}，无需手写长 PATH
Pipeline("selftest", "ductile 用 ductile 自测：unit → 正向/负向探针 → 脚本回归 → hyper → 汇总门禁")
  .proc("unit")
    .desc("Rust 单元测试")
    .plan(
      lib -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && cargo test --release --lib 2>&1 | grep '^test result'")
        .tags(#test)
        .desc("全绿标准：'; 0 failed'")
    )
  .proc("pos")
    .desc("正向探针：成功路径必须 success")
    .plan(
      p -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && ductile run pipelines/nocost_probe.pipeline regression 2>&1 | grep -c 'executed successfully'")
        .tags(#test)
        .desc("nocost_probe 计数=1")
    )
  .proc("neg")
    .desc("负向探针：ghost/disabled 必须硬错（v0.11 回归钉）")
    .plan(
      n -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && ductile check pipelines/weights_probe.pipeline >/dev/null 2>&1 && echo BAD-ghost-should-fail || echo ghost-ok; ductile check examples/full_syntax.pipeline >/dev/null 2>&1 && echo BAD-disabled-should-fail || echo disabled-ok")
        .tags(#test)
        .desc("两行输出都应是 *-ok")
    )
  .proc("scripts")
    .desc("可执行脚本回归（三件；disk-watch 限小 HOME 防 Windows 全盘 du 卡死）")
    .plan(
      s -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && export DUCTILE_HOME=\"${DUCTILE_HOME:-$ROOT/examples}\" DUCTILE_DATA=\"${DUCTILE_DATA:-$ROOT/examples}\" && ductile run examples/scripts/daily-digest.pipeline >/dev/null 2>&1 && ductile run examples/scripts/disk-watch.pipeline >/dev/null 2>&1 && ductile run examples/scripts/errflow-drill.pipeline >/dev/null 2>&1 && echo scripts-ok")
        .tags(#test)
        .desc("三脚本 ductile run 全 exit 0")
    )
  .proc("hyper")
    .desc("超图层/节点复用场景（parse/build/check/similar/nodes）")
    .plan(
      h -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && mkdir -p target/devcycle && bash examples/scripts/hyper_reuse_drill.sh 2>&1 | tee target/devcycle/hyper-reuse-drill.log | grep -q HYPER-REUSE-PASS && echo hyper-ok")
        .tags(#test, #hyper)
        .desc("HYPER-REUSE-PASS")
    )
  .proc("report")
    .desc("汇总门禁：全绿才 PASS，任一失败整流 exit 1（critical 链放大）")
    .plan(
      r -> run("ROOT=${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)} && cd \"$ROOT\" && mkdir -p target/devcycle && echo u='@unit' n='@neg' s='@scripts' h='@hyper' p='@pos' >/dev/null && { echo '@unit'; echo '@pos'; echo '@neg'; echo '@scripts'; echo '@hyper'; } > target/devcycle/selftest-summary.txt && grep -q '; 0 failed' target/devcycle/selftest-summary.txt && grep -q '^1$' target/devcycle/selftest-summary.txt && grep -q 'ghost-ok' target/devcycle/selftest-summary.txt && grep -q 'disabled-ok' target/devcycle/selftest-summary.txt && grep -q 'scripts-ok' target/devcycle/selftest-summary.txt && grep -q 'hyper-ok' target/devcycle/selftest-summary.txt && echo SELFTEST-PASS || (echo SELFTEST-FAIL; exit 1)")
        .tags(#gate)
        .desc("六重 grep 门禁（含 hyper）— 落盘文件版：@ref 含单引号不再炸 bash")
    )
  .proc("deliver")
    .plan(d -> run("echo done"))
    .deliver(@report)
