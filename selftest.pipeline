#!/usr/bin/env -S ductile run
// selftest.pipeline — ductile 自测（狗粮门禁）：单测+正负探针+脚本回归+hyper 复用
// 直跑：./selftest.pipeline   全绿输出 SELFTEST-PASS（exit 0）；任一失败 → report 判死 → exit 1
// 注意：llm-ping 依赖外部 LLM 桥，不进自测（避免网络抖动误杀门禁）
// PATH：引擎 run/spawn 自动注入 current_exe 与 target/{release,debug}，无需手写长 PATH
// v0.16 糖化：内联糖 + 管线 cwd（ROOT= 前缀消失，相对路径锚到仓库根）
Pipeline("selftest", "ductile 用 ductile 自测：unit → 正向/负向探针 → 脚本回归 → hyper → 汇总门禁", cwd="${DUCTILE_ROOT:-$(git rev-parse --show-toplevel)}")
  .proc("unit", run("cargo test --release --lib 2>&1 | grep '^test result'"))
    .desc("Rust 单元测试 — 全绿标准：'; 0 failed'")
  .proc("pos", run("ductile run pipelines/nocost_probe.pipeline regression 2>&1 | grep -c 'executed successfully'"))
    .desc("正向探针：nocost_probe 计数=1")
  .proc("neg", run("ductile check pipelines/weights_probe.pipeline >/dev/null 2>&1 && echo BAD-ghost-should-fail || echo ghost-ok; ductile check examples/full_syntax.pipeline >/dev/null 2>&1 && echo BAD-disabled-should-fail || echo disabled-ok"))
    .desc("负向探针：ghost/disabled 必须硬错（v0.11 回归钉）— 两行输出都应是 *-ok")
  .proc("scripts", run("export DUCTILE_HOME=\"${DUCTILE_HOME:-$PWD/examples}\" DUCTILE_DATA=\"${DUCTILE_DATA:-$PWD/examples}\" && ductile run examples/scripts/daily-digest.pipeline >/dev/null 2>&1 && ductile run examples/scripts/disk-watch.pipeline >/dev/null 2>&1 && ductile run examples/scripts/errflow-drill.pipeline >/dev/null 2>&1 && echo scripts-ok"))
    .desc("可执行脚本回归（三件；disk-watch 限小 HOME 防 Windows 全盘 du 卡死）")
  .proc("hyper", run("mkdir -p target/devcycle && bash examples/scripts/hyper_reuse_drill.sh 2>&1 | tee target/devcycle/hyper-reuse-drill.log | grep -q HYPER-REUSE-PASS && echo hyper-ok").tags(#hyper))
    .desc("超图层/节点复用场景（parse/build/check/similar/nodes）— HYPER-REUSE-PASS")
  .proc("cognition", run("DUCTILE_DATA=$(mktemp -d) ductile canary add selftest cognition-probe '已知好输入' '@self.score >= 80' 'note' | grep -q 'canary #' && DUCTILE_DATA=$(mktemp -d) ductile incident list --help >/dev/null 2>&1; DUCTILE_DATA=$(mktemp -d) ductile incident list | head -1 | grep -qE '^#[0-9]+ \\[|^\\(no incidents\\)' && echo cognition-ok").tags(#cognition))
    .desc("v0.15 认知回传探针：canary CRUD + incident 信号分层（真 CLI 跑，隔离 DUCTILE_DATA 不污染真库）")
  .proc("l4probe", run("D=$(mktemp -d) && DUCTILE_DATA=$D ductile l4 review selftest-l4 pass 'e2e probe' | grep -q 'recorded \\[pass\\]' && DUCTILE_DATA=$D ductile l4 label 1 ok | grep -q 'labeled ok' && DUCTILE_DATA=$D ductile l4 status | grep -q 'log_only' && echo l4-ok").tags(#l4))
    .desc("v0.15 L4 冷启动探针：log-only 记录 + 标签 + 状态机（真 CLI 跑）")
  .proc("patchorigin", run("D=$(mktemp -d) && DUCTILE_DATA=$D ductile patch selftest-po arch llm guide 'R1 白名单版' 2>/dev/null | grep -q 'origin: human' && DUCTILE_DATA=$D DUCTILE_PATCH_ORIGIN=llm:qwen3.8:27b ductile patch selftest-po brk llm guide 'R2 版' 2>/dev/null | grep -q 'origin: llm:qwen3.8:27b' && DUCTILE_DATA=$D ductile patch list 2>/dev/null | grep -c 'origin:' | grep -q '^2$' && DUCTILE_DATA=$D ductile patch clear selftest-po >/dev/null 2>&1 && echo patchorigin-ok").tags(#patch))
    .desc("v0.18.5 patch origin 探针：默认 human + env 注入 llm 出处 + list 计数（隔离 DUCTILE_DATA，不碰真库）")
  .proc("report", run("mkdir -p target/devcycle && { echo '@unit'; echo '@pos'; echo '@neg'; echo '@scripts'; echo '@hyper'; echo '@cognition'; echo '@l4probe'; echo '@patchorigin'; } > target/devcycle/selftest-summary.txt && grep -q '; 0 failed' target/devcycle/selftest-summary.txt && grep -q '^1$' target/devcycle/selftest-summary.txt && grep -q 'ghost-ok' target/devcycle/selftest-summary.txt && grep -q 'disabled-ok' target/devcycle/selftest-summary.txt && grep -q 'scripts-ok' target/devcycle/selftest-summary.txt && grep -q 'hyper-ok' target/devcycle/selftest-summary.txt && grep -q 'cognition-ok' target/devcycle/selftest-summary.txt && grep -q 'l4-ok' target/devcycle/selftest-summary.txt && grep -q 'patchorigin-ok' target/devcycle/selftest-summary.txt && echo SELFTEST-PASS || (echo SELFTEST-FAIL; exit 1)").tags(#gate))
    .desc("九重 grep 门禁 — 落盘文件版：@ref 含单引号不再炸 bash")
  .proc("deliver", run("echo done"))
    .deliver(@report)
