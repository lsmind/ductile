HyperGraph("iso_a")
  .require(judge=true)
  .vertex("load", role=source)
  .vertex("work", role=default)
  .vertex("judge", role=judge)
  .vertex("save", role=sink)
  .hedge("flow", kind=chain, load, work, save)
  .hedge("q", kind=gate, judge=judge, producers=work, consumers=save)
  .deliver(save)
